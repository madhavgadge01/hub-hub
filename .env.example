# Hub&Hub Environment Configuration Template

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration
# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
# Local Docker: postgresql://hubhub:hubhub_secret_dev_password@localhost:5432/hubhub_dev
# Or Cloud PostgreSQL (e.g., Neon / Supabase):
DB_URL=postgresql://hubhub:hubhub_secret_dev_password@localhost:5432/hubhub_dev
DB_SSL=false

# Redis Configuration (Rate Limiting & Caching)
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Authentication Secrets (Generate strong random 64-char strings in production)
ACCESS_TOKEN_SECRET=dev_access_token_secret_replace_in_production_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_replace_in_production_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Master API Key (Optional administrative bypass if configured)
MASTER_API_KEY=dh_live_master_admin_key_example

# Frontend (apps/frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
