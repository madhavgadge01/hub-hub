# Kruu Environment Configuration Template

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration
# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Local Docker: postgresql://hubhub:hubhub_secret_dev_password@localhost:5432/hubhub_dev
# Or Cloud PostgreSQL (e.g., Neon / Supabase):
DB_URL=postgresql://hubhub:hubhub_secret_dev_password@localhost:5432/hubhub_dev
DB_SSL=false

# Redis Configuration (Rate Limiting & Caching)
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Authentication Secrets (Generate strong random 64-char strings in production)
ACCESS_TOKEN_SECRET=dev_access_token_secret_replace_in_production_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_replace_in_production_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Master API Key (Optional administrative bypass if configured)
MASTER_API_KEY=dh_live_master_admin_key_example

# Brevo (Sendinblue) Transactional Email Delivery (Registration OTP, Welcome, Password Reset)
# Obtain API key from https://app.brevo.com/settings/keys/api


# Cloudflare Turnstile CAPTCHA Integration (Login Protection)
# Obtain keys from Cloudflare Dashboard -> Turnstile
# For local development testing:
# Test Site Key (Always Passes): 1x00000000000000000000AA
# Test Secret Key (Always Passes): 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google OAuth 2.0 / OpenID Connect (Continue with Google)
# Obtain client credentials from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Section 2: Razorpay Payment Gateway Integration
# Obtain keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Frontend Environment Variables (apps/frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
